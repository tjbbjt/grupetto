diff --git a/app/src/test/java/com/spop/poverlay/HeartRateZoneMathTest.kt b/app/src/test/java/com/spop/poverlay/HeartRateZoneMathTest.kt
new file mode 100644
index 0000000..2fac8bd
--- /dev/null
+++ b/app/src/test/java/com/spop/poverlay/HeartRateZoneMathTest.kt
@@ -0,0 +1,55 @@
+package com.spop.poverlay
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class HeartRateZoneMathTest {
+    private val none = listOf<Int?>(null, null, null, null)
+    private val defaults = listOf<Int?>(108, 126, 144, 162)
+
+    @Test
+    fun `one boundary fills the blank rest at 60 70 80 90 percent of max`() {
+        assertEquals(defaults, fillZoneBoundaries(none, listOf(null, 126, null, null), 1))
+        assertEquals(defaults, fillZoneBoundaries(none, listOf(108, null, null, null), 0))
+        assertEquals(defaults, fillZoneBoundaries(none, listOf(null, null, null, 162), 3))
+    }
+
+    @Test
+    fun `changing one of an automatic set moves the whole set`() {
+        // Max 190: 114, 133, 152, 171
+        assertEquals(
+            listOf<Int?>(114, 133, 152, 171),
+            fillZoneBoundaries(defaults, listOf(108, 133, 144, 162), 1)
+        )
+    }
+
+    @Test
+    fun `boundaries typed by hand are left alone`() {
+        // 100 is not the automatic value for 126, so it stays; the automatic ones follow.
+        assertEquals(
+            listOf<Int?>(100, 133, 152, 171),
+            fillZoneBoundaries(listOf(100, 126, 144, 162), listOf(100, 133, 144, 162), 1)
+        )
+    }
+
+    @Test
+    fun `blank or zero anchor changes nothing`() {
+        assertEquals(none, fillZoneBoundaries(none, none, 2))
+        val zero = listOf<Int?>(0, null, null, null)
+        assertEquals(zero, fillZoneBoundaries(none, zero, 0))
+    }
+
+    @Test
+    fun `wrong sized lists are returned unchanged`() {
+        val short = listOf<Int?>(126)
+        assertEquals(short, fillZoneBoundaries(short, short, 0))
+    }
+
+    @Test
+    fun `tapping into a box without changing it recalculates nothing`() {
+        // 160 was entered in the last box, giving 107 for the first. Tapping 107 must not move 160.
+        val filled = fillZoneBoundaries(none, listOf(null, null, null, 160), 3)
+        assertEquals(listOf<Int?>(107, 124, 142, 160), filled)
+        assertEquals(filled, fillZoneBoundaries(filled, filled, 0))
+    }
+}
diff --git a/app/src/test/java/com/spop/poverlay/sensor/ScanBudgetTest.kt b/app/src/test/java/com/spop/poverlay/sensor/ScanBudgetTest.kt
new file mode 100644
index 0000000..6d84f28
--- /dev/null
+++ b/app/src/test/java/com/spop/poverlay/sensor/ScanBudgetTest.kt
@@ -0,0 +1,57 @@
+package com.spop.poverlay.sensor
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ScanBudgetTest {
+    private val minute = 60_000L
+
+    @Test
+    fun `scanning is allowed until a window has been opened`() {
+        assertTrue(ScanBudget().allows(10 * minute))
+    }
+
+    @Test
+    fun `window closes after five minutes`() {
+        val budget = ScanBudget()
+        budget.arm(0)
+        assertTrue(budget.allows(4 * minute))
+        assertFalse(budget.allows(5 * minute))
+    }
+
+    @Test
+    fun `first movement opens a fresh window`() {
+        val budget = ScanBudget()
+        budget.arm(0)
+        assertTrue(budget.onMovement(true, 20 * minute))
+        assertTrue(budget.allows(24 * minute))
+        assertFalse(budget.allows(25 * minute))
+    }
+
+    @Test
+    fun `a short pause while riding does not open a new window`() {
+        val budget = ScanBudget()
+        budget.onMovement(true, 0)
+        assertFalse(budget.onMovement(false, 10 * minute))
+        assertFalse(budget.onMovement(true, 12 * minute))
+        assertFalse(budget.allows(12 * minute))
+    }
+
+    @Test
+    fun `riding again after a long idle opens a new window`() {
+        val budget = ScanBudget()
+        budget.onMovement(true, 0)
+        budget.onMovement(false, 10 * minute)
+        assertTrue(budget.onMovement(true, 16 * minute))
+        assertTrue(budget.allows(17 * minute))
+    }
+
+    @Test
+    fun `repeated moving reports do not reopen the window`() {
+        val budget = ScanBudget()
+        assertTrue(budget.onMovement(true, 0))
+        assertFalse(budget.onMovement(true, 6 * minute))
+        assertFalse(budget.allows(6 * minute))
+    }
+}
