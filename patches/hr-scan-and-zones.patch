diff --git a/app/src/test/java/com/spop/poverlay/HeartRateZoneMathTest.kt b/app/src/test/java/com/spop/poverlay/HeartRateZoneMathTest.kt
new file mode 100644
index 0000000..c020bfb
--- /dev/null
+++ b/app/src/test/java/com/spop/poverlay/HeartRateZoneMathTest.kt
@@ -0,0 +1,55 @@
+package com.spop.poverlay
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class HeartRateZoneMathTest {
+    private val none = listOf<Int?>(null, null, null, null, null)
+    private val defaults = listOf<Int?>(90, 108, 126, 144, 162)
+
+    @Test
+    fun `one boundary fills the blank rest at 50 60 70 80 90 percent of max`() {
+        assertEquals(defaults, fillZoneBoundaries(none, listOf(null, null, 126, null, null), 2))
+        assertEquals(defaults, fillZoneBoundaries(none, listOf(90, null, null, null, null), 0))
+        assertEquals(defaults, fillZoneBoundaries(none, listOf(null, null, null, null, 162), 4))
+    }
+
+    @Test
+    fun `changing one of an automatic set moves the whole set`() {
+        // Max 190: 95, 114, 133, 152, 171
+        assertEquals(
+            listOf<Int?>(95, 114, 133, 152, 171),
+            fillZoneBoundaries(defaults, listOf(90, 108, 133, 144, 162), 2)
+        )
+    }
+
+    @Test
+    fun `boundaries typed by hand are left alone`() {
+        // 85 is not the automatic value for 126, so it stays; the automatic ones follow.
+        assertEquals(
+            listOf<Int?>(85, 114, 133, 152, 171),
+            fillZoneBoundaries(listOf(85, 108, 126, 144, 162), listOf(85, 108, 133, 144, 162), 2)
+        )
+    }
+
+    @Test
+    fun `blank or zero anchor changes nothing`() {
+        assertEquals(none, fillZoneBoundaries(none, none, 2))
+        val zero = listOf<Int?>(0, null, null, null, null)
+        assertEquals(zero, fillZoneBoundaries(none, zero, 0))
+    }
+
+    @Test
+    fun `wrong sized lists are returned unchanged`() {
+        val short = listOf<Int?>(126)
+        assertEquals(short, fillZoneBoundaries(short, short, 0))
+    }
+
+    @Test
+    fun `tapping into a box without changing it recalculates nothing`() {
+        // 160 was entered in the last box, giving 107 for zone 2. Tapping 107 must not move 160.
+        val filled = fillZoneBoundaries(none, listOf(null, null, null, null, 160), 4)
+        assertEquals(listOf<Int?>(89, 107, 124, 142, 160), filled)
+        assertEquals(filled, fillZoneBoundaries(filled, filled, 1))
+    }
+}
